{
  "name": "aura",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": "22.14.x" },
  "scripts": {
    "test:node": "node --test tools/quality/tests/*.test.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "quality": "pnpm typecheck && pnpm test:node && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "22.15.30",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4"
  }
}
