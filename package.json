{
  "name": "aura",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.14.x"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:boundaries": "node tools/quality/check-boundaries.mjs packages/domain/src apps/game-client/assets/scripts",
    "check:secrets": "node tools/quality/check-secrets.mjs .",
    "test:node": "node --test tools/quality/tests/*.test.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "quality": "prettier --check . && eslint . && node tools/quality/check-boundaries.mjs packages/domain/src apps/game-client/assets/scripts && node tools/quality/check-secrets.mjs . && tsc -b && node --test tools/quality/tests/*.test.mjs && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "22.15.30",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.33.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.4"
  }
}
